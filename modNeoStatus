' Creation date: 2026-10-14
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   EnableNeoInteraction - UPDATE06.
'-------------------------------------------------------------------------------
Public Sub EnableNeoInteraction()
    Const METHOD_NAME As String = "EnableNeoInteraction"
    Dim wbMaster As Workbook
    Dim ws As Worksheet
    Dim lo As ListObject
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set wbMaster = Application.ActiveWorkbook
    Call ResetErrors
    If wbMaster Is Nothing Then Err.Raise TOOL_ERROR + 125, METHOD_NAME, "No active workbook."
    Set ws = RequiredSheet(wbMaster, SHEET_DASHBOARD)
    Set lo = ws.ListObjects(TABLE_DASHBOARD)
    ' This explicit repair command intentionally enables events; it is not temporary suspension.
    Application.EnableEvents = True
    MsgBox "UPDATE06: zdarzenia Excela wlaczone." & vbCrLf & _
        "Dwuklik w Done/Doubt albo zaznacz wiersze i kliknij prawym wewnatrz zaznaczenia." & vbCrLf & _
        "Kod Dashboard_Sheet musi byc w module ARKUSZA Dashboard.", vbInformation, "NeoAdvices"

ExitPoint:
    Set lo = Nothing
    Set ws = Nothing
    Set wbMaster = Nothing
    If errNumber <> 0 Then Call DisplayErrors
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub
