Option Explicit

Private Const CLASS_NAME As String = "modNeoStatus"
Private pMenuChoice As Long

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-14
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   ApplyNeoStatus - UPDATE06.
'-------------------------------------------------------------------------------
Public Sub ApplyNeoStatus(ByVal ws As Worksheet, ByVal target As Range, ByVal mode As Long)
    Const METHOD_NAME As String = "ApplyNeoStatus"
    Dim lo As ListObject
    Dim hit As Range
    Dim area As Range
    Dim selectedRow As Range
    Dim rowKeys As Object
    Dim key As Variant
    Dim rowIndex As Long
    Dim marks(1 To 1, 1 To 2) As Variant
    Dim state As TExcelState
    Dim cleanupFailed As Boolean
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    If mode < 0 Or mode > 2 Then
        Err.Raise TOOL_ERROR + 120, METHOD_NAME, "Unknown status mode."
    End If
    If Not target.Parent Is ws Then
        Err.Raise TOOL_ERROR + 121, METHOD_NAME, "Status target belongs to another worksheet."
    End If
    If ws.ProtectContents Then
        Err.Raise TOOL_ERROR + 122, METHOD_NAME, "Unprotect Dashboard before changing statuses."
    End If
    Set lo = ws.ListObjects(TABLE_DASHBOARD)
    Set rowKeys = CreateObject("Scripting.Dictionary")
    If Not lo.DataBodyRange Is Nothing Then
        Set hit = Application.Intersect(target, lo.DataBodyRange)
        If Not hit Is Nothing Then
            For Each area In hit.Areas
                For Each selectedRow In area.Rows
                    If Not selectedRow.EntireRow.Hidden Then
                        rowIndex = selectedRow.Row - lo.DataBodyRange.Row + 1
                        If Not rowKeys.Exists(rowIndex) Then rowKeys.Add rowIndex, True
                    End If
                Next selectedRow
            Next area
        End If
    End If
    If rowKeys.Count > 0 Then
        marks(1, 1) = ChrW(&H2610)
        marks(1, 2) = ChrW(&H2610)
        If mode = 1 Then marks(1, 1) = ChrW(&H2713)
        If mode = 2 Then marks(1, 2) = "?"
        Call CaptureExcelState(state)
        Application.EnableEvents = False
        Application.ScreenUpdating = False
        For Each key In rowKeys.Keys
            lo.DataBodyRange.Rows(CLng(key)).Cells(1, 1).Resize(1, 2).Value2 = marks
        Next key
        ' Existing conditional formats preserve CANC backgrounds and movement font colors.
        Call UpdateProgressCounters(ws)
        ws.Calculate
    End If

ExitPoint:
    Call RestoreExcelStateSafe(state, cleanupFailed)
    Set selectedRow = Nothing
    Set area = Nothing
    Set hit = Nothing
    Set rowKeys = Nothing
    Set lo = Nothing
    If cleanupFailed And errNumber = 0 Then
        errNumber = TOOL_ERROR + 123
        errDescription = "Could not restore Excel state after changing statuses."
    End If
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-14
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   ChooseNeoStatus - UPDATE06.
'-------------------------------------------------------------------------------
Public Function ChooseNeoStatus(ByVal wb As Workbook) As Long
    Const METHOD_NAME As String = "ChooseNeoStatus"
    Dim popup As CommandBar
    Dim button As CommandBarButton
    Dim captions As Variant
    Dim macros As Variant
    Dim index As Long
    Dim cleanupFailed As Boolean
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    pMenuChoice = -1
    captions = Array("Done - selected visible rows", "Doubt - selected visible rows", _
        "Clear status - selected visible rows")
    macros = Array("NeoMenuDone", "NeoMenuDoubt", "NeoMenuClear")
    Set popup = Application.CommandBars.Add(Position:=msoBarPopup, Temporary:=True)
    For index = 0 To 2
        Set button = popup.Controls.Add(Type:=msoControlButton, Temporary:=True)
        button.Caption = CStr(captions(index))
        button.Style = msoButtonCaption
        button.OnAction = "'" & Replace(wb.Name, "'", "''") & "'!" & CStr(macros(index))
    Next index
    popup.ShowPopup
    ChooseNeoStatus = pMenuChoice

ExitPoint:
    Call DeleteNeoPopupSafe(popup, cleanupFailed)
    Set button = Nothing
    pMenuChoice = -1
    If cleanupFailed And errNumber = 0 Then
        errNumber = TOOL_ERROR + 124
        errDescription = "Could not remove the temporary status menu."
    End If
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Function

