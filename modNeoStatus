'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-14
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   Delete only this event's temporary menu; preserve the original error.
'-------------------------------------------------------------------------------
Private Sub DeleteNeoPopupSafe(ByRef popup As CommandBar, ByRef hadFailure As Boolean)
    Dim cleanupNumber As Long
    Dim cleanupDescription As String

    On Error Resume Next
    VBA.Err.Clear
    If Not popup Is Nothing Then popup.Delete
    cleanupNumber = VBA.Err.Number
    cleanupDescription = VBA.Err.Description
    VBA.Err.Clear
    On Error GoTo 0
    Set popup = Nothing
    If cleanupNumber <> 0 Then
        hadFailure = True
        Call RecordError(CLASS_NAME, "DeleteNeoPopupSafe", cleanupNumber, cleanupDescription)
    End If
End Sub

