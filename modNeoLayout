' Returns:       Shared defaults folder or the local folder beside the launcher.
' Description:   Resolve the configured preferences location before generating outputs.
'-------------------------------------------------------------------------------
Public Function LayoutDefaultsFolder(ByVal wb As Workbook) As String
    Const METHOD_NAME As String = "LayoutDefaultsFolder"
    Dim result As String
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    result = LayoutValue(wb, "Folder")
    If Len(result) = 0 Then result = wb.Path & "\NeoAdvices_Settings"
    If InStr(1, result, "://", vbTextCompare) > 0 Then
        Err.Raise TOOL_ERROR + 164, METHOD_NAME, _
            "Run ConfigureNeoSettingsFolder and choose a Windows or shared network folder."
    End If
    LayoutDefaultsFolder = result

ExitPoint:
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-15
' Parameters:    None.
' Returns:       None.
' Description:   Choose and persist the shared defaults folder in the launcher.
'-------------------------------------------------------------------------------
Public Sub ConfigureNeoSettingsFolder()
    Const METHOD_NAME As String = "ConfigureNeoSettingsFolder"
    Dim wbMaster As Workbook
    Dim picker As FileDialog
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set wbMaster = Application.ActiveWorkbook
    Call ResetErrors
    If wbMaster Is Nothing Then Err.Raise TOOL_ERROR + 150, METHOD_NAME, "No active workbook."
    If wbMaster.ReadOnly Or Len(wbMaster.Path) = 0 Then
        Err.Raise TOOL_ERROR + 156, METHOD_NAME, "Use a saved, writable launcher workbook."
    End If
    If HasCopyMarker(wbMaster) Or HasNeoFlag(wbMaster, RESULT_MARKER) Then
        Err.Raise TOOL_ERROR + 165, METHOD_NAME, "Configure the shared folder in the launcher."
    End If
    Set picker = Application.FileDialog(msoFileDialogFolderPicker)
    picker.Title = "Choose a defaults folder accessible to the generator and Accountants"
    If picker.Show = -1 Then
        Call SetLayoutValue(wbMaster, "Folder", picker.SelectedItems(1))
        wbMaster.Save
        MsgBox "Shared defaults folder saved. Generate new output files with Run.", _
            vbInformation, "NeoAdvices"
    End If

ExitPoint:
    Set picker = Nothing
    Set wbMaster = Nothing
    If errNumber <> 0 Then Call DisplayErrors
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-19
' Parameters:    wb: current output; layout: legacy preference array to migrate.
' Returns:       Updated layout in the supplied array.
' Description:   Migrate changed fields by name and retain all other preferences.
'-------------------------------------------------------------------------------
Private Sub UpgradeLegacyLayout(ByVal wb As Workbook, ByRef layout As Variant)
    Const METHOD_NAME As String = "UpgradeLegacyLayout"
    Dim entries As Object
    Dim revised As Variant
    Dim changedPositions As Variant
    Dim item As Variant
    Dim descriptionHeader As String
    Dim bankHeader As String
    Dim mffaHeader As String
    Dim header As String
    Dim i As Long
    Dim position As Long
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    ' Positions refer to the captured UPDATE21 default, never the user's live layout.
    descriptionHeader = LayoutValue(wb, "Header9")
    bankHeader = DashboardHeader("4_D_GL_Bank Ref")
    mffaHeader = "MFFA description"
    Set entries = CreateObject("Scripting.Dictionary")
    entries.CompareMode = vbTextCompare
    For i = 1 To UBound(layout, 1)
        entries.Add CStr(layout(i, 1)), CDbl(layout(i, 2))
    Next i
    changedPositions = Array(8, 9, 10, 13, 14, 16, 18, 19, 20, 21)
    For Each item In changedPositions
        header = LayoutValue(wb, "Header" & CStr(item))
        If Not entries.Exists(header) Then
            Err.Raise TOOL_ERROR + 181, METHOD_NAME, "Missing field during layout migration."
        End If
        entries(header) = Val(LayoutValue(wb, "Width" & CStr(item)))
    Next item
    ReDim revised(1 To UBound(layout, 1), 1 To 2)
    For i = 1 To UBound(layout, 1)
        header = CStr(layout(i, 1))
        If header <> descriptionHeader And header <> bankHeader And header <> mffaHeader Then
            position = position + 1
            revised(position, 1) = header
            revised(position, 2) = entries(header)
            If header = DashboardHeader(HDR_STATUS) Then
                position = position + 1
                revised(position, 1) = descriptionHeader
                revised(position, 2) = entries(descriptionHeader)
                position = position + 1
                revised(position, 1) = bankHeader
                revised(position, 2) = entries(bankHeader)
            ElseIf header = HDR_ACCOUNTANT Then
                position = position + 1
                revised(position, 1) = mffaHeader
                revised(position, 2) = entries(mffaHeader)
            End If
        End If
    Next i
    If position <> UBound(layout, 1) Then
        Err.Raise TOOL_ERROR + 182, METHOD_NAME, "Layout migration did not retain every field."
    End If
    layout = revised

ExitPoint:
    Set entries = Nothing
    revised = Empty
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub
