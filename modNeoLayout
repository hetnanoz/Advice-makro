'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-15
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   UPDATE16: ApplyLayout.
'-------------------------------------------------------------------------------
Private Sub ApplyLayout(ByVal wb As Workbook, ByRef layout As Variant)
    Const METHOD_NAME As String = "ApplyLayout"
    Dim ws As Worksheet
    Dim lo As ListObject
    Dim source As Variant
    Dim result() As Variant
    Dim oldWidths() As Variant
    Dim oldFormats() As Variant
    Dim widths() As Variant
    Dim formats() As Variant
    Dim map As Object
    Dim i As Long
    Dim r As Long
    Dim sourceIndex As Long
    Dim state As TExcelState
    Dim cleanupFailed As Boolean
    Dim mutated As Boolean
    Dim recoveryNumber As Long
    Dim recoveryDescription As String
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set ws = wb.Worksheets(SHEET_DASHBOARD)
    Set lo = ws.ListObjects(TABLE_DASHBOARD)
    If ws.ProtectContents Or wb.ReadOnly Then
        Err.Raise TOOL_ERROR + 156, METHOD_NAME, "Dashboard is protected or read-only."
    End If
    If UBound(layout, 1) <> lo.ListColumns.Count Then
        Err.Raise TOOL_ERROR + 157, METHOD_NAME, "Layout does not match current columns."
    End If
    If layout(1, 1) <> "Done" Or layout(2, 1) <> "Doubt" Or layout(3, 1) <> "Issue" Then
        Err.Raise TOOL_ERROR + 154, METHOD_NAME, "Done/Doubt/Issue must stay first."
    End If
    source = lo.Range.Value2
    ReDim result(1 To UBound(source, 1), 1 To UBound(source, 2))
    ReDim widths(1 To lo.ListColumns.Count)
    ReDim formats(1 To lo.ListColumns.Count)
    ReDim oldWidths(1 To lo.ListColumns.Count)
    ReDim oldFormats(1 To lo.ListColumns.Count)
    Set map = CreateObject("Scripting.Dictionary")
    For i = 1 To lo.ListColumns.Count
        map.Add lo.ListColumns(i).Name, i
        oldWidths(i) = lo.ListColumns(i).Range.ColumnWidth
        oldFormats(i) = lo.ListColumns(i).Range.Cells(lo.ListColumns(i).Range.Rows.Count, 1).NumberFormat
    Next i
    For i = 1 To UBound(layout, 1)
        If Not map.Exists(CStr(layout(i, 1))) Then
            Err.Raise TOOL_ERROR + 157, METHOD_NAME, "Unknown or duplicate layout column."
        End If
        sourceIndex = CLng(map(CStr(layout(i, 1))))
        map.Remove CStr(layout(i, 1))
        widths(i) = CDbl(layout(i, 2))
        If widths(i) < 3 Or widths(i) > 80 Then
            Err.Raise TOOL_ERROR + 155, METHOD_NAME, "Width range: 3 to 80."
        End If
        formats(i) = oldFormats(sourceIndex)
        For r = 1 To UBound(source, 1)
            result(r, i) = source(r, sourceIndex)
        Next r
    Next i
    Call CaptureExcelState(state)
    Application.EnableEvents = False
    Application.ScreenUpdating = False
    Call modNeoDashboard.RemoveAllSlicerCaches(wb)
    If lo.AutoFilter.FilterMode Then lo.AutoFilter.ShowAllData
    mutated = True
    Call WriteLayoutTable(ws, result, widths, formats)
    mutated = False

ExitPoint:
    If mutated And errNumber <> 0 Then
        On Error Resume Next
        VBA.Err.Clear
        Call RestoreLayoutSafe(ws, source, oldWidths, oldFormats)
        recoveryNumber = VBA.Err.Number
        recoveryDescription = VBA.Err.Description
        VBA.Err.Clear
        On Error GoTo 0
        If recoveryNumber <> 0 Then
            Call RecordError(CLASS_NAME, "RestoreLayoutSafe", recoveryNumber, recoveryDescription)
        End If
    End If
    Call RestoreExcelStateSafe(state, cleanupFailed)
    If cleanupFailed And errNumber = 0 Then
        errNumber = TOOL_ERROR + 158
        errDescription = "Could not restore Excel state after layout change."
    End If
    Set map = Nothing
    Set lo = Nothing
    Set ws = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub


