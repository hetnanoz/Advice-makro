'-------------------------------------------------------------------------------
Private Sub BuildSettingsEditor(ByVal wbMaster As Workbook)
    Const METHOD_NAME As String = "BuildSettingsEditor"
    Dim ws As Worksheet
    Dim item As Worksheet
    Dim lo As ListObject
    Dim i As Long
    Dim button As Shape
    Dim captions As Variant
    Dim macros As Variant
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    If wbMaster Is Nothing Then Err.Raise TOOL_ERROR + 150, METHOD_NAME, "No active workbook."
    If wbMaster.ReadOnly Or wbMaster.ProtectStructure Then
        Err.Raise TOOL_ERROR + 156, METHOD_NAME, "Workbook is read-only or its structure is protected."
    End If
    Set lo = wbMaster.Worksheets(SHEET_DASHBOARD).ListObjects(TABLE_DASHBOARD)
    If Len(LayoutValue(wbMaster, "Count")) = 0 Then
        Err.Raise TOOL_ERROR + 151, METHOD_NAME, "Regenerate this file using UPDATE16 first."
    End If
    For Each item In wbMaster.Worksheets
        If item.Name = SETTINGS_SHEET Then Set ws = item
    Next item
    If ws Is Nothing Then
        Set ws = wbMaster.Worksheets.Add(After:=wbMaster.Worksheets(wbMaster.Worksheets.Count))
        ws.Name = SETTINGS_SHEET
    End If
    ws.Cells.Clear
    ws.Columns(2).NumberFormat = "@"
    For i = ws.Shapes.Count To 1 Step -1
        ws.Shapes(i).Delete
    Next i
    ws.Range("A1").Value2 = "COLUMN SETTINGS | " & LayoutValue(wbMaster, "Owner")
    ws.Range("A2").Value2 = "Edit Order (unique numbers 4..N) and Width, then click Apply."
    ws.Range("A3").Value2 = "Done/Doubt/Issue stay first. Apply clears filters; data and status marks are retained."
    ws.Range("A4").Value2 = "Defaults folder: " & LayoutValue(wbMaster, "Folder")
    ws.Range("A5").Value2 = "Save defaults affects future files. Save the workbook separately."
    ws.Range("A7").Value2 = "Order"
    ws.Range("B7").Value2 = "Column name (do not edit)"
    ws.Range("C7").Value2 = "Width"
    For i = 1 To lo.ListColumns.Count
        ws.Cells(i + 7, 1).Value2 = i
        ws.Cells(i + 7, 2).Value2 = lo.ListColumns(i).Name
        ws.Cells(i + 7, 3).Value2 = lo.ListColumns(i).Range.ColumnWidth
    Next i
    ws.Columns(1).ColumnWidth = 12
    ws.Columns(2).ColumnWidth = 45
    ws.Columns(3).ColumnWidth = 12
    ws.Range("A1").Font.Bold = True
    Call FormatHeader(ws.Range("A7:C7"))
    captions = Array("Apply", "Save as my default", "Reset to default")
    macros = Array("ApplyNeoColumnSettings", "SaveNeoColumnSettings", "ResetNeoColumnSettings")
    For i = 0 To 2
        Set button = ws.Shapes.AddShape(msoShapeRoundedRectangle, 510, 120 + i * 36, 180, 28)
        button.TextFrame.Characters.Text = CStr(captions(i))
        button.Fill.ForeColor.RGB = RGB(31, 78, 121)
        button.TextFrame.Characters.Font.Color = RGB(255, 255, 255)
        button.OnAction = "'" & Replace(wbMaster.Name, "'", "''") & "'!" & CStr(macros(i))
    Next i

ExitPoint:
    Set button = Nothing
    Set lo = Nothing
    Set item = Nothing
    Set ws = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-15
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   UPDATE16: ReadEditorLayout.
'-------------------------------------------------------------------------------
Private Function ReadEditorLayout(ByVal wb As Workbook) As Variant
    Const METHOD_NAME As String = "ReadEditorLayout"
    Dim ws As Worksheet
    Dim lo As ListObject
    Dim result() As Variant
    Dim seen As Object
    Dim i As Long
    Dim rank As Long
    Dim value As Variant
    Dim width As Double
    Dim header As String
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set ws = wb.Worksheets(SETTINGS_SHEET)
    Set lo = wb.Worksheets(SHEET_DASHBOARD).ListObjects(TABLE_DASHBOARD)
    Set seen = CreateObject("Scripting.Dictionary")
    ReDim result(1 To lo.ListColumns.Count, 1 To 2)
    For i = 1 To lo.ListColumns.Count
        value = ws.Cells(i + 7, 1).Value2
        If IsError(value) Then Err.Raise TOOL_ERROR + 152, METHOD_NAME, "Invalid order."
        If Not IsNumeric(value) Then Err.Raise TOOL_ERROR + 152, METHOD_NAME, "Order must be numeric."
        If CDbl(value) <> Fix(CDbl(value)) Or CDbl(value) < 1 Or CDbl(value) > lo.ListColumns.Count Then
            Err.Raise TOOL_ERROR + 152, METHOD_NAME, "Order must contain unique integers 1..N."
        End If
        rank = CLng(value)
        If seen.Exists(rank) Then Err.Raise TOOL_ERROR + 152, METHOD_NAME, "Duplicate order number."
        seen.Add rank, True
        header = CleanText(ws.Cells(i + 7, 2).Value2)
        If header <> lo.ListColumns(i).Name Then
            Err.Raise TOOL_ERROR + 153, METHOD_NAME, "Column names or editor rows changed. Reopen settings."
        End If
        If i <= 3 And rank <> i Then Err.Raise TOOL_ERROR + 154, METHOD_NAME, "Done/Doubt/Issue cannot move."
        value = ws.Cells(i + 7, 3).Value2
        If IsError(value) Then Err.Raise TOOL_ERROR + 155, METHOD_NAME, "Invalid width."
        If Not IsNumeric(value) Then Err.Raise TOOL_ERROR + 155, METHOD_NAME, "Width must be numeric."
        width = CDbl(value)
        If width < 3 Or width > 80 Then Err.Raise TOOL_ERROR + 155, METHOD_NAME, "Width range: 3 to 80."
        result(rank, 1) = header
        If i = 1 Then width = 6
        If i = 2 Or i = 3 Then width = 5.5
        result(rank, 2) = width
    Next i
    ReadEditorLayout = result

ExitPoint:
    Set seen = Nothing
    Set lo = Nothing
    Set ws = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Function


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-15
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   UPDATE16: WriteLayoutTable.
'-------------------------------------------------------------------------------
Private Sub WriteLayoutTable(ByVal ws As Worksheet, ByRef values As Variant, _
                             ByRef widths As Variant, ByRef formats As Variant)
    Const METHOD_NAME As String = "WriteLayoutTable"
    Dim lo As ListObject
    Dim target As Range
    Dim i As Long
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    For Each lo In ws.ListObjects
        If lo.Name = TABLE_DASHBOARD Then
            lo.Unlist
            Exit For
        End If
    Next lo
    Set target = ws.Cells(DASH_HEADER_ROW, 1).Resize(UBound(values, 1), UBound(values, 2))
    target.Clear
    target.NumberFormat = "@"
    target.Value2 = values
    Set lo = ws.ListObjects.Add(SourceType:=xlSrcRange, Source:=target, XlListObjectHasHeaders:=xlYes)
    lo.Name = TABLE_DASHBOARD
    lo.TableStyle = vbNullString
    lo.ShowTableStyleRowStripes = False
    lo.ShowTableStyleColumnStripes = False
    For i = 1 To UBound(values, 2)
        lo.ListColumns(i).Range.NumberFormat = CStr(formats(i))
        ws.Columns(i).ColumnWidth = CDbl(widths(i))
    Next i
    Call FormatHeader(lo.HeaderRowRange)
    Call ApplyDataFormatting(ws, DASH_HEADER_ROW, _
        DASH_HEADER_ROW + UBound(values, 1) - 1, UBound(values, 2), True)

ExitPoint:
    Set target = Nothing
    Set lo = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub


