Option Explicit

Private Const CLASS_NAME As String = "modNeoLayout"
Private Const SETTINGS_SHEET As String = "Column settings"


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-15
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   UPDATE16: SetLayoutValue.
'-------------------------------------------------------------------------------
Public Sub SetLayoutValue(ByVal wb As Workbook, ByVal key As String, ByVal value As String)
    Const METHOD_NAME As String = "SetLayoutValue"

    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    wb.Names.Add Name:="_NeoLayout_" & key, _
        RefersTo:="=""" & Replace(value, """", """""") & """", Visible:=False

ExitPoint:

    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-15
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   UPDATE16: LayoutValue.
'-------------------------------------------------------------------------------
Private Function LayoutValue(ByVal wb As Workbook, ByVal key As String) As String
    Const METHOD_NAME As String = "LayoutValue"
    Dim entry As Name
    Dim shortName As String
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    For Each entry In wb.Names
        shortName = entry.Name
        If InStrRev(shortName, "!") > 0 Then shortName = Mid$(shortName, InStrRev(shortName, "!") + 1)
        If StrComp(shortName, "_NeoLayout_" & key, vbTextCompare) = 0 Then
            LayoutValue = Replace(Mid$(entry.RefersTo, 3, Len(entry.RefersTo) - 3), """""", """")
            Exit For
        End If
    Next entry

ExitPoint:
    Set entry = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Function


