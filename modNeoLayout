'-------------------------------------------------------------------------------
Public Sub CaptureLayoutDefault(ByVal wb As Workbook)
    Const METHOD_NAME As String = "CaptureLayoutDefault"
    Dim lo As ListObject
    Dim i As Long
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set lo = wb.Worksheets(SHEET_DASHBOARD).ListObjects(TABLE_DASHBOARD)
    Call SetLayoutValue(wb, "Count", CStr(lo.ListColumns.Count))
    Call SetLayoutValue(wb, "Owner", "__MASTER__")
    For i = 1 To lo.ListColumns.Count
        Call SetLayoutValue(wb, "Header" & CStr(i), lo.ListColumns(i).Name)
        Call SetLayoutValue(wb, "Width" & CStr(i), Trim$(Str$(lo.ListColumns(i).Range.ColumnWidth)))
    Next i

ExitPoint:
    Set lo = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub


