' Creation date: 2026-10-15
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   UPDATE16: LayoutFilePath.
'-------------------------------------------------------------------------------
Private Function LayoutFilePath(ByVal wb As Workbook) As String
    Const METHOD_NAME As String = "LayoutFilePath"
    Dim fso As Object
    Dim folder As String
    Dim owner As String
    Dim encoded As String
    Dim i As Long
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set fso = CreateObject("Scripting.FileSystemObject")
    folder = LayoutValue(wb, "Folder")
    owner = LayoutValue(wb, "Owner")
    If Len(folder) = 0 Or Len(owner) = 0 Then
        Err.Raise TOOL_ERROR + 159, METHOD_NAME, "Defaults folder or Accountant identity is missing."
    End If
    For i = 1 To Len(owner)
        encoded = encoded & Right$("0000" & Hex$(AscW(Mid$(LCase$(owner), i, 1)) And &HFFFF&), 4)
    Next i
    LayoutFilePath = fso.BuildPath(folder, encoded & ".xml")
    If Len(LayoutFilePath) > 240 Then
        Err.Raise TOOL_ERROR + 160, METHOD_NAME, "Defaults path is too long; shorten the launcher path."
    End If

ExitPoint:
    Set fso = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Function

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Function


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-15
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   UPDATE16: SaveLayoutFile.
'-------------------------------------------------------------------------------
Private Sub SaveLayoutFile(ByVal wb As Workbook, ByRef layout As Variant)
    Const METHOD_NAME As String = "SaveLayoutFile"
    Dim xml As Object
    Dim node As Object
    Dim rootNode As Object
    Dim fso As Object
    Dim filePath As String
    Dim tempPath As String
    Dim folder As String
    Dim i As Long
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Set fso = CreateObject("Scripting.FileSystemObject")
    filePath = LayoutFilePath(wb)
    folder = fso.GetParentFolderName(filePath)
    If Not fso.FolderExists(folder) Then fso.CreateFolder folder
    Set xml = CreateObject("MSXML2.DOMDocument.6.0")
    Set rootNode = xml.createElement("layout")
    rootNode.setAttribute "owner", LayoutValue(wb, "Owner")
    rootNode.setAttribute "schema", "24"
    xml.appendChild rootNode
    For i = 1 To UBound(layout, 1)
        Set node = xml.createElement("column")
        node.setAttribute "name", CStr(layout(i, 1))
        node.setAttribute "width", Trim$(Str$(CDbl(layout(i, 2))))
        rootNode.appendChild node
    Next i
    tempPath = fso.BuildPath(folder, fso.GetTempName)
    xml.Save tempPath
    If fso.FileExists(filePath) Then fso.CopyFile filePath, filePath & ".bak", True
    fso.CopyFile tempPath, filePath, True
    fso.DeleteFile tempPath, False
    MsgBox "Default layout saved for " & LayoutValue(wb, "Owner") & ".", vbInformation, "NeoAdvices"

ExitPoint:
    Set node = Nothing
    Set rootNode = Nothing
    Set xml = Nothing
    Set fso = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-10-15
' Parameters:    See typed signature.
' Returns:       See typed signature.
' Description:   UPDATE16: LoadAccountantLayout.
'-------------------------------------------------------------------------------
Public Sub LoadAccountantLayout(ByVal wb As Workbook, ByVal accountantName As String)
    Const METHOD_NAME As String = "LoadAccountantLayout"
    Dim fso As Object
    Dim xml As Object
    Dim nodes As Object
    Dim node As Object
    Dim lo As ListObject
    Dim schemaVersion As Variant
    Dim saved As Object
    Dim layout() As Variant
    Dim filePath As String
    Dim header As String
    Dim i As Long
    Dim position As Long
    Dim errNumber As Long
    Dim errDescription As String

    If Not DEV_MODE Then On Error GoTo ErrHandler

    Call SetLayoutValue(wb, "Owner", accountantName)
    Set fso = CreateObject("Scripting.FileSystemObject")
    filePath = LayoutFilePath(wb)
    If fso.FileExists(filePath) Then
        Set xml = CreateObject("MSXML2.DOMDocument.6.0")
        xml.async = False
        xml.resolveExternals = False
        xml.setProperty "ProhibitDTD", True
        If Not xml.Load(filePath) Then Err.Raise TOOL_ERROR + 161, METHOD_NAME, "Invalid layout XML."
        If StrComp(CStr(xml.documentElement.getAttribute("owner")), accountantName, vbTextCompare) <> 0 Then
            Err.Raise TOOL_ERROR + 162, METHOD_NAME, "Layout Accountant does not match output owner."
        End If
        Set lo = wb.Worksheets(SHEET_DASHBOARD).ListObjects(TABLE_DASHBOARD)
        Set saved = CreateObject("Scripting.Dictionary")
        For i = 1 To lo.ListColumns.Count
            saved.Add lo.ListColumns(i).Name, lo.ListColumns(i).Range.ColumnWidth
        Next i
        ReDim layout(1 To lo.ListColumns.Count, 1 To 2)
        For i = 1 To 3
            header = lo.ListColumns(i).Name
            layout(i, 1) = header
            layout(i, 2) = lo.ListColumns(i).Range.ColumnWidth
            saved.Remove header
        Next i
        position = 3
        Set nodes = xml.selectNodes("/layout/column")
        For Each node In nodes
            header = DashboardHeader(CStr(node.getAttribute("name")))
            If saved.Exists(header) Then
                position = position + 1
                layout(position, 1) = header
                layout(position, 2) = Val(CStr(node.getAttribute("width")))
                saved.Remove header
            End If
        Next node
        ' Append new fields in current default order; obsolete saved fields are ignored.
        For i = 1 To lo.ListColumns.Count
            header = lo.ListColumns(i).Name
            If saved.Exists(header) Then
                position = position + 1
                layout(position, 1) = header
                layout(position, 2) = saved(header)
            End If
        Next i
        schemaVersion = xml.documentElement.getAttribute("schema")
        If IsNull(schemaVersion) Then
            Call UpgradeLegacyLayout(wb, layout)
        ElseIf CStr(schemaVersion) <> "21" And CStr(schemaVersion) <> "24" Then
            Call UpgradeLegacyLayout(wb, layout)
        End If
        Call ApplyLayout(wb, layout)
    End If

ExitPoint:
    Set saved = Nothing
    Set lo = Nothing
    Set node = Nothing
    Set nodes = Nothing
    Set xml = Nothing
    Set fso = Nothing
    If errNumber <> 0 Then
        Call VBA.Err.Raise(errNumber, CLASS_NAME & "." & METHOD_NAME, errDescription)
    End If
    Exit Sub

ErrHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Call RecordError(CLASS_NAME, METHOD_NAME, errNumber, errDescription)
    GoTo ExitPoint
End Sub

